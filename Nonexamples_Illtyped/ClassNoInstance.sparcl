-- It is intentional that this program causes a type error.
-- There is no instance for the goal `Eq Int` (E-3, E-4 in
-- notes/extend-type-class_2026.txt).

data Nat = Z | S Nat

class Eq a where
    sig eq : a -> a -> Bool
end

instance eqNat : Eq Nat where
    def eq x y = True
end

sig f : Int -> Bool
def f x = eq x x
