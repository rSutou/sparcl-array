-- It is intentional that this program causes a type error.
-- An explicitly passed instance {{e}} must correspond to an instance
-- argument {{C}} -> of the function type (D-1 in
-- notes/extend-type-class_2026.txt); `f` takes an ordinary argument.

data Nat = Z | S Nat

class Eq a where
    sig eq : a -> a -> Bool
end

instance eqNat : Eq Nat where
    def eq x y = True
end

sig f : Nat -> Nat -> Bool
def f x = eq {{eqNat}} x

def g y = f {{eqNat}} y
