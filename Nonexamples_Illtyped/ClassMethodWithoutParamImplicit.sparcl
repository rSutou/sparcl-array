-- It is intentional that this program causes a type error.
-- The type of `size` does not mention the class parameter `a`, so nothing
-- determines the instance argument `Sized ?a` of an implicit use: the goal
-- is ambiguous (G-2 5 and E-2 in notes/extend-type-class_2026.txt). Passing
-- the instance explicitly, `size {{sizedNat}}`, works
-- (Examples/ClassMethodWithoutParam.sparcl).

data Nat = Z | S Nat

class Sized a where
    sig size : Int
end

instance sizedNat : Sized Nat where
    def size = 1
end

-- (With the signature, the goal is reported as ambiguous; without it, as an
-- instance argument that cannot be inferred for a definition without a
-- signature.)
sig n : Int
def n = size
