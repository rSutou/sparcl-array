-- It is intentional that this program causes a type error.
-- The body of `eq` in the instance for `Eq Nat` is checked against
-- `Nat -> Nat -> Bool` (G-5 3 in notes/extend-type-class_2026.txt), but
-- returns a `Nat`.

data Nat = Z | S Nat

class Eq a where
    sig eq : a -> a -> Bool
end

instance eqNat : Eq Nat where
    def eq x y = x
end
