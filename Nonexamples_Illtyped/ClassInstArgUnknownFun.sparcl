-- It is intentional that this program causes a type error.
-- An explicitly passed instance {{e}} cannot be given to a function whose
-- type is not known (D-1, A-4 in notes/extend-type-class_2026.txt).

data Nat = Z | S Nat

class Eq a where
    sig eq : a -> a -> Bool
end

instance eqNat : Eq Nat where
    def eq x y = True
end

def g h = h {{eqNat}}
