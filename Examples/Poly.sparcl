-- Examples using higher-rank polymorphism.

sig ex0 : (forall x. x -> x) -> (Int, Bool)
def ex0 f = (f 42, f True)

data List a = Nil | Cons a (List a) 

sig append : List a -> List a -> List a 
def append Nil ys = ys 
         | (Cons x xs) ys = Cons x (append xs ys) 

sig concatMap : (a -> List b) -> List a -> List b 
def concatMap f Nil = Nil 
            | f (Cons x xs) = append (f x) (concatMap f xs) 


sig ex1 : (forall x. List x -> List x) 
def ex1 = \x -> x 

-- Currently, () -> forall x. x causes a parse error. 
sig any : forall x. () -> x
def any x = any x 

def ex2 () = (any () : forall x. x -> x) : forall y. List y -> List y 
def ex3 () = (any () : forall x. x -> x) : forall a b. (a, b) -> (a, b) 
def ex4 () = (any () : forall a b. (a, b) -> (a, b)) : forall c. (c , c) -> (c, c) 

-- Having signatures is crucial for them to have higher polymorphic type. 
-- Otherwise, it would try to unify a polytype with a monotype, which is 
-- not permitted in the current system. 
sig ex5 : () -> (forall x. x -> x) -> Bool
def ex5 () = (any () : (Int -> Int) -> Bool) 

sig ex6 : () -> (forall x. x -> x) -> Bool 
def ex6 () = (any () : (forall x. List x -> List x) -> Bool) 

-- Nested datatype 
data Tree a = Leaf a | Next (Tree (a , a))

sig treeMap : (a -> b) -> Tree a -> Tree b 
def treeMap f (Leaf a) = Leaf (f a) 
          | f (Next t) = Next (treeMap (\(x,y) -> (f x , f y)) t)

-- Codensity monad 
data F a = F (forall r. (a -> List r) -> List r)

def unF (F x) = x 

sig pureF : a -> F a 
def pureF x = F (\k -> k x) 

sig bindF : F a -> (a -> F b) -> F b 
def bindF (F m) f = F (\k -> m (\a -> unF (f a) k))

data ListF where end 

data App m a where 
  sig AppList : List a -> App ListF a 
end

data Mon m = MkMon (forall a. a -> App m a) (forall a b. App m a -> (a -> App m b) -> App m b)

sig listMon : Mon ListF 
def listMon = 
    MkMon (\x -> AppList (Cons x Nil))
          (\(AppList x) f -> AppList (concatMap (\x' -> case f x' of AppList y -> y end) x))

sig cartesian : Mon m -> App m a -> App m b -> App m (a , b) 
def cartesian (MkMon pure bind) m1 m2 = 
    bind m1 (\a -> 
    bind m2 (\b -> 
    pure (a, b)))

sig cartesianList : List (Int, Int)
def cartesianList = 
    case cartesian listMon (AppList (Cons 1 (Cons 2 Nil))) (AppList (Cons 3 (Cons 4 (Cons 5 Nil)))) of 
        AppList xs -> xs 
    end 

-- 

data Either a b = Left a | Right b 

data WithE a b = MkWithE (forall r. Either (a -o r) (b -o r) #1 -> r)

sig proj1E : WithE a b -o a 
def proj1E (MkWithE m) = m (Left (\x -> x))

sig proj2E : WithE a b -o b 
def proj2E (MkWithE m) = m (Right (\x -> x)) 

-- Y and WithG are taken from Kmett's talk slide
data Y a b c where
  sig L : Y a b a
  sig R : Y a b b
end 

data WithG a b = MkWithG (forall c. Y a b c -> c)

sig withG : (forall c. Y a b c -> c) #1 -> WithG a b
def withG = MkWithG

sig proj1G : WithG a b -o a 
def proj1G (MkWithG m) = m L

sig proj2G : WithG a b -o b 
def proj2G (MkWithG m) = m R 

sig system2either : &(a , b) -o WithE a b 
def system2either m = MkWithE (\x -> case x of Left k -> k (&0_2 m) | Right k -> k (&1_2 m) end)

sig either2gadt : WithE a b -o WithG a b 
def either2gadt m = MkWithG (\x -> case x of L -> proj1E m | R -> proj2E m end)

sig gadt2system : WithG a b -o &(a, b) 
def gadt2system m = &(proj1G m , proj2G m) 

sig withTestE : a -o WithE a a 
def withTestE x = MkWithE (\z -> case z of Left k -> k x | Right k -> k x end)

sig withTestG : a -o WithG a a 
def withTestG x = MkWithG (\z -> case z of L -> x | R -> x end)

sig withTestS : a -o &(a , a) 
def withTestS x = &(x , x) 

-- The current type system does not allow us to define a constructor as a function 
-- because it does not allow multiplicity 0. Check the inferred types of the following functions. 

def mkWithNonLinearE x y = MkWithE (\z -> case z of Left k -> k x | Right k -> k y end)
def mkWithNonLinearS x y = &(x, y) 

-- We need the type signature for this version (due to GADT pattern matching)
sig mkWithNonLinearG : a -> b -> WithG a b 
def mkWithNonLinearG x y = MkWithG (\z -> case z of L -> x | R -> y end)
