-- Higher-rank values bound by `let` and matched by `case`.
--
-- The bound expression of `let p <- e1 in e2` and the scrutinee of
-- `case e0 of ...` are inferred, so a higher-rank type is kept and the bound
-- variable can be used polymorphically. (Passing `ex0` as an argument of an
-- application, `(\g -> g (\y -> y)) ex0`, is rejected, since an argument is
-- checked against a meta variable.) Kept as a regression test: see D-2 (F1)
-- in notes/extend-type-class_2026.txt.

sig ex0 : (forall x. x -> x) -> (Int, Bool)
def ex0 f = (f 42, f True)

def t1 = let g <- ex0 in g (\y -> y)

def t3 = case ex0 of g -> g (\y -> y) end

-- Parentheses around the head of an application.
def t4 = (ex0) (\y -> y)

-- An operator applied to an argument of polymorphic type (operator
-- applications are checked as applications, D-3).
fixity $$ 0 right
sig ($$) : ((forall x. x -> x) -> (Int, Bool)) -> (forall x. x -> x) -> (Int, Bool)
def ($$) f k = f k

def t5 = ex0 $$ (\y -> y)

-- A scrutinee and a bound expression that need a trailing instance
-- argument. They are inferred, but with the "expand last" flag set (D-2
-- (F1)), so the instance argument after `3` is inserted; the pattern then
-- fixes `a` to `Int`, and the goal `Default Int` is solved by `dInt`.
data Box a = Box a

class Default a where
    sig dflt : a
end

instance dInt : Default Int where
    def dflt = 0
end

sig pick : Int -> {{Default a}} -> Box a
def pick _ = Box dflt

def t6 = case pick 3 of Box n -> n + 1 end

def t7 = let Box m <- pick 3 in m + 2

-- Expected values (compared with t6 .. t7 by test/Spec.hs)

def t6' = 1
def t7' = 2
